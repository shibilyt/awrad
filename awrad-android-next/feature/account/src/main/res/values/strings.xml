<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Titles -->
    <string name="account_title_sign_in">Sign in</string>
    <string name="account_title_register">Create an account</string>
    <string name="account_title_verify">Verify your email</string>
    <string name="account_title_forgot">Reset your password</string>
    <string name="account_title_reset">Choose a new password</string>
    <string name="account_title_signed_in">Your account</string>

    <!-- Body text -->
    <string name="account_intro">An account is optional. Everything works on this device without one.</string>
    <string name="account_forgot_body">Enter your account\'s email and we\'ll send you a code to reset your password.</string>
    <string name="account_code_sent_to">Enter the 6-digit code we emailed to %1$s. It works for 15 minutes.</string>
    <string name="account_signed_in_as">Signed in as</string>
    <string name="account_signed_in_body">Your practice stays on this device. Signing out doesn\'t remove it.</string>

    <!-- Fields -->
    <string name="account_field_email">Email</string>
    <string name="account_field_password">Password</string>
    <string name="account_field_new_password">New password</string>
    <string name="account_field_code">6-digit code</string>

    <!-- Actions -->
    <string name="account_action_sign_in">Sign in</string>
    <string name="account_action_register">Create account</string>
    <string name="account_action_verify">Verify</string>
    <string name="account_action_send_code">Send code</string>
    <string name="account_action_reset_password">Set new password</string>
    <string name="account_action_resend">Send a new code</string>
    <string name="account_action_resend_wait">Send a new code (%1$s)</string>
    <string name="account_action_forgot_password">Forgot your password?</string>
    <string name="account_action_go_register">Create an account</string>
    <string name="account_action_go_sign_in">I already have an account</string>
    <string name="account_action_sign_out">Sign out</string>
    <string name="account_action_back">Back</string>
