    <!-- Notices -->
    <string name="account_notice_code_sent">ഞങ്ങൾ നിങ്ങൾക്ക് ഒരു കോഡ് ഇമെയിൽ ചെയ്തിട്ടുണ്ട്.</string>
    <string name="account_notice_verification_required">ആദ്യം നിങ്ങളുടെ ഇമെയിൽ സ്ഥിരീകരിക്കുക. ഞങ്ങൾ പുതിയൊരു കോഡ് അയച്ചിട്ടുണ്ട്.</string>
    <string name="account_notice_email_verified">നിങ്ങളുടെ ഇമെയിൽ സ്ഥിരീകരിച്ചു. തുടരാൻ സൈൻ ഇൻ ചെയ്യുക.</string>
    <string name="account_notice_password_changed">പാസ്‌വേഡ് മാറ്റി. പുതിയ പാസ്‌വേഡ് ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യുക.</string>
    <string name="account_notice_signed_out">നിങ്ങൾ സൈൻ ഔട്ട് ചെയ്തു. നിങ്ങളുടെ പരിശീലനം ഇപ്പോഴും ഈ ഉപകരണത്തിലുണ്ട്.</string>

    <!-- Field problems -->
    <string name="account_error_email_invalid">സാധുവായ ഒരു ഇമെയിൽ വിലാസം നൽകുക.</string>
    <string name="account_error_password_too_common">ഈ പാസ്‌വേഡ് വളരെ സാധാരണമാണ്. മറ്റൊന്ന് തിരഞ്ഞെടുക്കുക.</string>
    <string name="account_error_code_format">ഇമെയിലിലെ 6 അക്ക കോഡ് നൽകുക.</string>

    <!-- Errors, one per problem code -->
    <string name="account_error_invalid_input">നൽകിയ വിവരങ്ങൾ പരിശോധിച്ച് വീണ്ടും ശ്രമിക്കുക.</string>
    <string name="account_error_verification_code_invalid">ആ കോഡ് തെറ്റാണ് അല്ലെങ്കിൽ കാലഹരണപ്പെട്ടു. ഇമെയിൽ പരിശോധിക്കുക, അല്ലെങ്കിൽ പുതിയ കോഡ് അയയ്ക്കുക.</string>
    <string name="account_error_reset_code_invalid">ആ കോഡ് തെറ്റാണ് അല്ലെങ്കിൽ കാലഹരണപ്പെട്ടു. ഇമെയിൽ പരിശോധിക്കുക, അല്ലെങ്കിൽ പുതിയ കോഡ് അയയ്ക്കുക.</string>
    <string name="account_error_invalid_credentials">ഇമെയിലോ പാസ്‌വേഡോ തെറ്റാണ്.</string>
    <string name="account_error_session_ended">ഈ ഉപകരണത്തിൽ നിങ്ങൾ സൈൻ ഔട്ട് ആയി. വീണ്ടും സൈൻ ഇൻ ചെയ്യുക.</string>
    <string name="account_error_rate_limited">വളരെയധികം ശ്രമങ്ങൾ. അൽപ്പസമയം കാത്തിരുന്ന് വീണ്ടും ശ്രമിക്കുക.</string>
    <string name="account_error_request_rejected">ആപ്പിന് ആ അഭ്യർത്ഥന പൂർത്തിയാക്കാനായില്ല. ആപ്പ് അപ്‌ഡേറ്റ് ചെയ്ത് വീണ്ടും ശ്രമിക്കുക.</string>
    <string name="account_error_no_connection">കണക്ഷൻ ഇല്ല. ഇന്റർനെറ്റ് പരിശോധിച്ച് വീണ്ടും ശ്രമിക്കുക.</string>
    <string name="account_error_unexpected">ഞങ്ങളുടെ ഭാഗത്ത് എന്തോ പിശക് സംഭവിച്ചു. പിന്നീട് വീണ്ടും ശ്രമിക്കുക.</string>

