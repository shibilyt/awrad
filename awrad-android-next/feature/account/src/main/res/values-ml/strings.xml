    <!-- Body text -->
    <string name="account_change_password_body">മറ്റെല്ലാ ഉപകരണങ്ങളും ബ്രൗസറുകളും സൈൻ ഔട്ട് ആകും. ഈ ഉപകരണം സൈൻ ഇൻ ആയി തുടരും.</string>
    <string name="account_change_email_body">പുതിയ വിലാസത്തിലേക്ക് ഞങ്ങൾ ഒരു 6 അക്ക കോഡ് ഇമെയിൽ ചെയ്യും. അത് നൽകിയ ശേഷം മാത്രമേ നിങ്ങളുടെ ഇമെയിൽ മാറൂ.</string>
    <string name="account_delete_what_goes">അക്കൗണ്ട് ഇല്ലാതാക്കിയാൽ അതും ഞങ്ങളുടെ സെർവർ അതിനായി സൂക്ഷിക്കുന്ന എല്ലാം ഉടൻ നീക്കം ചെയ്യും. ഇത് പഴയപടിയാക്കാനാവില്ല.</string>
    <string name="account_delete_what_stays">ഈ ഉപകരണത്തിലെ നിങ്ങളുടെ പരിശീലനം നിലനിൽക്കും, അക്കൗണ്ട് ഇല്ലാതെയും ആപ്പ് പ്രവർത്തിക്കും.</string>
    <string name="account_delete_sessions">അക്കൗണ്ടിൽ സൈൻ ഇൻ ചെയ്‌തിട്ടുള്ള എല്ലാ ഉപകരണങ്ങളും ബ്രൗസറുകളും സൈൻ ഔട്ട് ആകും. അവയിലെ പരിശീലന ഡാറ്റയും നിലനിൽക്കും.</string>
    <string name="account_delete_confirm_title">നിങ്ങളുടെ അക്കൗണ്ട് ഇപ്പോൾ ഇല്ലാതാക്കണോ?</string>
    <string name="account_delete_confirm_body">നിങ്ങളുടെ അക്കൗണ്ടും സെർവറിലെ അതിന്റെ ഡാറ്റയും ഉടൻ ഇല്ലാതാകും, വീണ്ടെടുക്കാനാവില്ല.</string>

