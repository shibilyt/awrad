    <string name="account_title_signed_in">നിങ്ങളുടെ അക്കൗണ്ട്</string>

    <!-- Body text -->
    <string name="account_intro">അക്കൗണ്ട് നിർബന്ധമല്ല. അതില്ലാതെയും ഈ ഉപകരണത്തിൽ എല്ലാം പ്രവർത്തിക്കും.</string>
    <string name="account_forgot_body">നിങ്ങളുടെ അക്കൗണ്ടിന്റെ ഇമെയിൽ നൽകുക. പാസ്‌വേഡ് റീസെറ്റ് ചെയ്യാനുള്ള കോഡ് ഞങ്ങൾ അയയ്ക്കും.</string>
    <string name="account_code_sent_to">%1$s എന്ന വിലാസത്തിലേക്ക് ഞങ്ങൾ അയച്ച 6 അക്ക കോഡ് നൽകുക. ഇത് 15 മിനിറ്റ് സാധുവാണ്.</string>
    <string name="account_signed_in_as">സൈൻ ഇൻ ചെയ്തിരിക്കുന്നത്</string>
    <string name="account_signed_in_body">നിങ്ങളുടെ പരിശീലനം ഈ ഉപകരണത്തിൽ തന്നെ നിലനിൽക്കും. സൈൻ ഔട്ട് ചെയ്താലും അത് നീക്കം ചെയ്യപ്പെടില്ല.</string>

