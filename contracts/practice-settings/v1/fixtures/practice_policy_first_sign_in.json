{
  "format": "awrad-fixture/1",
  "rule": "practice_policy_first_sign_in",
  "description": "The phone's practice policy after signing in from the anonymous profile. The account's policy wins once it has one, whatever the user chose for their data; an account that has none takes this phone's, only if the user chose it (chosen: changed a setting since the profile was created). Into an account profile already on the phone, that profile keeps its own.",
  "references": [
    "docs/slices/03d-practice-settings.md (Decisions: First sign-in)",
    "contracts/sync/v1/fixtures/profile_switch.json",
    "awrad-android/app/src/main/java/app/awrad/awrad_dhikrgoalstracker/data/sync/PracticeSettingsReconciliation.kt:29-59",
    "awrad-ios/awrad/awradTests/PracticeSettingsSyncTests.swift:13-54"
  ],
  "given_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "event",
      "choice",
      "local",
      "account",
      "existing_profile"
    ],
    "properties": {
      "event": {
        "enum": [
          "first_sign_in",
          "existing_profile"
        ],
        "description": "first_sign_in: the anonymous profile becomes the account's. existing_profile: the account already has a profile on the phone."
      },
      "choice": {
        "enum": [
          "add",
          "erase",
          "none"
        ],
        "description": "The answer to Add to my account / Erase; none when the profile was empty and nothing was asked."
      },
      "local": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document",
          "chosen"
        ],
        "properties": {
          "document": {
            "$ref": "urn:awrad:practice-settings:1#/$defs/practice_policy_document"
          },
          "chosen": {
            "type": "boolean"
          }
        }
      },
      "account": {
        "description": "The account's practice_policy in the changes feed (after=0), or null when it has none.",
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "document"
            ],
            "properties": {
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "document": {
                "$ref": "urn:awrad:practice-settings:1#/$defs/practice_policy_document"
              }
            }
          },
          {
            "type": "null"
          }
        ]
      },
      "existing_profile": {
        "description": "The account profile already on the phone (existing_profile only).",
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "document",
              "known_version"
            ],
            "properties": {
              "document": {
                "$ref": "urn:awrad:practice-settings:1#/$defs/practice_policy_document"
              },
              "known_version": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "expect_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "document",
      "known_version",
      "queued"
    ],
    "properties": {
      "document": {
        "$ref": "urn:awrad:practice-settings:1#/$defs/practice_policy_document"
      },
      "known_version": {
        "type": "integer",
        "minimum": 0
      },
      "queued": {
        "description": "The practice_policy put queued, or null.",
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "base_version",
              "document"
            ],
            "properties": {
              "base_version": {
                "const": 0
              },
              "document": {
                "$ref": "urn:awrad:practice-settings:1#/$defs/practice_policy_document"
              }
            }
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
