{
  "format": "awrad-fixture/1",
  "rule": "maghrib_time",
  "description": "Maghrib on a local date at a place, with a calculation method: sunset, plus the method's Maghrib adjustment (3 minutes for dubai and moonsighting_committee). Platforms compute it with the adhan library and must agree within 60 seconds; the expected instants are rounded to the minute, as adhan rounds. null when the sun doesn't set or rise that day, and then the Maghrib reset falls back to midnight. The madhab doesn't affect Maghrib.",
  "references": [
    "CONTEXT.md#practice-settings-language (Effective practice day)",
    "contracts/goal-model/v1/fixtures/effective_practice_day.json",
    "awrad_server/assets/js/practice_day.js:24-76",
    "awrad-ios/awrad/awrad/Core/AppServices.swift:995-1115"
  ],
  "given_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "date",
      "latitude",
      "longitude",
      "calculation_method"
    ],
    "properties": {
      "date": {
        "$ref": "urn:awrad:goal-model:1#/$defs/date"
      },
      "latitude": {
        "type": "number",
        "minimum": -90,
        "maximum": 90
      },
      "longitude": {
        "type": "number",
        "minimum": -180,
        "maximum": 180
      },
      "calculation_method": {
        "$ref": "urn:awrad:practice-settings:1#/$defs/calculation_method"
      }
    }
  },
  "expect_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "maghrib"
    ],
    "properties": {
      "maghrib": {
        "oneOf": [
          {
            "$ref": "urn:awrad:goal-model:1#/$defs/instant"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
