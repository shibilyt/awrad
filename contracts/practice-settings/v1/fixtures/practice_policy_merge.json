{
  "format": "awrad-fixture/1",
  "rule": "practice_policy_merge",
  "description": "Merge by setting, when a practice_policy put conflicts (phones) or is refused as stale (web): every setting where mine differs from the base keeps mine, the rest is theirs, and Hijri corrections merge month by month. Corrections that aren't valid after the merge fall back to theirs, with the notice hijri_corrections_replaced. requeue says whether the merged document differs from theirs and must be sent.",
  "references": [
    "docs/slices/03d-practice-settings.md (Design: On phones, Conflict)",
    "awrad-android/app/src/main/java/app/awrad/awrad_dhikrgoalstracker/data/sync/PracticeSettingsRepository.kt:96-99"
  ],
  "given_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "base",
      "mine",
      "theirs"
    ],
    "properties": {
      "base": {
        "$ref": "urn:awrad:practice-settings:1#/$defs/practice_policy_document",
        "description": "The server copy mine was edited from; the default policy when the phone knew none."
      },
      "mine": {
        "$ref": "urn:awrad:practice-settings:1#/$defs/practice_policy_document"
      },
      "theirs": {
        "$ref": "urn:awrad:practice-settings:1#/$defs/practice_policy_document",
        "description": "The server's current copy (the conflict receipt's current.document)."
      }
    }
  },
  "expect_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "document",
      "requeue",
      "notice"
    ],
    "properties": {
      "document": {
        "$ref": "urn:awrad:practice-settings:1#/$defs/practice_policy_document"
      },
      "requeue": {
        "type": "boolean"
      },
      "notice": {
        "oneOf": [
          {
            "const": "hijri_corrections_replaced"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
