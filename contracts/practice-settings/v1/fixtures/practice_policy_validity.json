{
  "format": "awrad-fixture/1",
  "rule": "practice_policy_validity",
  "description": "Which practice_policy documents are valid, with {field, code} errors sorted by field, then code. Pointers are into the document (the server prefixes /document in receipts).",
  "references": [
    "CONTEXT.md#practice-settings-language",
    "docs/slices/03d-practice-settings.md",
    "contracts/hijri-calendar/v1/fixtures/hijri_corrections_validity.json",
    "awrad_server/lib/awrad_server/practice_settings/account_practice_policy.ex:7-44"
  ],
  "given_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "document"
    ],
    "properties": {
      "document": {
        "type": "object",
        "description": "Any JSON object; it may be invalid."
      }
    }
  },
  "expect_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "valid",
      "errors"
    ],
    "properties": {
      "valid": {
        "type": "boolean"
      },
      "errors": {
        "type": "array",
        "items": {
          "$ref": "urn:awrad:sync:1#/$defs/field_error"
        }
      }
    }
  },
  "cases": [
    {
      "id": "default_policy",
      "description": "The default policy is valid.",
      "given": {
        "document": {
          "day_reset": "midnight",
          "calculation_method": "karachi",
          "madhab": "shafi",
          "week_start": "monday",
          "hijri_corrections": []
        }
      },
      "expect": {
        "valid": true,
        "errors": []
      }
    },
    {
      "id": "every_member_set",
      "description": "Maghrib reset, a method that moves Maghrib, Hanafi, Saturday and one correction.",
      "given": {
        "document": {
          "day_reset": "maghrib",
          "calculation_method": "dubai",
          "madhab": "hanafi",
          "week_start": "saturday",
          "hijri_corrections": [
            {
              "year": 1447,
              "month": 9,
              "offset_days": 1
            }
          ]
        }
      },
      "expect": {
        "valid": true,
        "errors": []
      }
    },
    {
      "id": "week_start_sunday",
      "description": "Sunday is a week start.",
      "given": {
        "document": {
          "day_reset": "midnight",
          "calculation_method": "karachi",
          "madhab": "shafi",
          "week_start": "sunday",
          "hijri_corrections": []
        }
      },
      "expect": {
        "valid": true,
        "errors": []
      }
    },
    {
      "id": "moonsighting_committee",
      "description": "Methods use adhan's names.",
