{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:awrad:contracts:fixture-file:1",
  "title": "Awrad behaviour fixture file (format awrad-fixture/1)",
  "description": "One file per domain rule. See contracts/FIXTURES.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "rule", "description", "references", "given_schema", "expect_schema", "cases"],
  "properties": {
    "format": { "const": "awrad-fixture/1" },
    "rule": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "description": { "type": "string", "minLength": 1 },
    "references": {
      "description": "Evidence: CONTEXT.md terms, ADRs, frozen-app code or tests the rule came from.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "given_schema": { "type": "object", "description": "JSON Schema every case's `given` must satisfy." },
    "expect_schema": { "type": "object", "description": "JSON Schema every case's `expect` must satisfy." },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "given", "expect"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "description": { "type": "string", "minLength": 1 },
          "given": { "type": "object" },
          "expect": { "type": "object" }
        }
      }
    }
  }
}
