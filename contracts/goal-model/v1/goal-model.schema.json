                    ],
                    "properties": {
                      "end_date": {
                        "type": "string"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "duration_days"
                    ],
                    "properties": {
                      "duration_days": {
                        "type": "integer"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "sessions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "count_policy": {
                    "type": "object",
                    "properties": {
                      "streak_threshold": {
                        "not": {
                          "const": "daily_pace"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
