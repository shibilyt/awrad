                "type": "array",
                "maxItems": 0
              },
              "requirement": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "not": {
                      "const": "tracker"
                    }
                  }
                }
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "count_policy": {
                "type": "object",
                "required": [
                  "target"
                ],
                "properties": {
                  "target": {
                    "$ref": "#/$defs/count"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "sessions"
            ],
            "properties": {
              "sessions": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "sessions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "count_policy": {
                      "$ref": "#/$defs/count_policy_valid"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "sessions",
              "requirement"
            ],
            "properties": {
              "sessions": {
                "type": "array",
                "minItems": 1
              },
              "requirement": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "not": {
                      "const": "tracker"
                    }
                  }
                }
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
