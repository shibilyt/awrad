                    "type": "null"
                  }
                }
              },
              "sessions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "count_policy": {
                      "type": "object",
                      "properties": {
                        "minimum": {
                          "type": "null"
                        },
                        "maximum": {
                          "type": "null"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "count_policy"
            ],
            "properties": {
              "count_policy": {
                "type": "object",
                "required": [
