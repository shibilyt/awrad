                      ],
                      "properties": {
                        "target": {
                          "$ref": "#/$defs/count"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "not": {
            "type": "object",
            "required": [
              "active_period"
            ],
            "properties": {
              "active_period": {
                "type": "object",
                "required": [
