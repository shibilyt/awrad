    "goal_rules": {
      "description": "The validity rules a schema can express (goal_validity.json has them all, with error codes): a target unless tracker (on every session when there are sessions); a streak threshold pointing at a value that is set; an end date or a number of days, not both; make-up only on per-due-date goals; sessions XOR a minimum or cap; daily_pace only on a cumulative total with an end, never on a session. Session IDs and kinds, and the document rules, are checked by tools/check-goal-model.mjs.",
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "sessions"
            ],
            "properties": {
