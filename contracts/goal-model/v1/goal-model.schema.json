                    "type": "string"
                  },
                  "duration_days": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "make_up"
            ],
            "properties": {
              "make_up": {
                "type": "object",
                "required": [
                  "window"
                ],
                "properties": {
                  "window": {
                    "not": {
                      "const": "off"
                    }
                  }
                }
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "requirement"
            ],
            "properties": {
              "requirement": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "per_due_date"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "sessions"
            ],
            "properties": {
              "sessions": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "count_policy": {
                "type": "object",
                "properties": {
