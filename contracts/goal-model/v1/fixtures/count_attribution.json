{
  "format": "awrad-fixture/1",
  "rule": "count_attribution",
  "description": "Which count-log entries fill which goal, as the per-day, per-session counts every other rule consumes (decisions 1 and 2). An entry fills the goals of its dhikr: a shared goal takes entries without a goal_id, a dedicated goal only entries with its own ID. With sessions in the day's version, an entry goes to the session with its session_id (others are dropped); without, to the day. Entries sum per day and session; a sum of 0 or less is no count.",
  "references": [
    "CONTEXT.md#goal-language (Shared and dedicated counts)",
    "docs/slices/04-goals-decisions.md decisions 1, 2, 5, 38 and 39",
    "DECISIONS.md ADR-2026-10-31 (Counts belong to the dhikr)"
  ],
  "given_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "log",
      "goals"
    ],
    "properties": {
      "log": {
        "type": "array",
        "items": {
          "$ref": "urn:awrad:goal-model:1#/$defs/count_log_entry"
        }
      },
      "goals": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "dhikr_id",
            "counts",
            "goal"
          ],
          "properties": {
            "id": {
              "$ref": "urn:awrad:goal-model:1#/$defs/uuid"
            },
            "dhikr_id": {
              "$ref": "urn:awrad:goal-model:1#/$defs/uuid"
            },
            "counts": {
              "enum": [
                "shared",
                "dedicated"
              ]
            },
            "goal": {
              "$ref": "urn:awrad:goal-model:1#/$defs/goal_timeline"
            }
          }
        }
      }
    }
  },
  "expect_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "goals"
    ],
    "properties": {
      "goals": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "counts"
          ],
          "properties": {
            "id": {
              "$ref": "urn:awrad:goal-model:1#/$defs/uuid"
            },
            "counts": {
              "type": "array",
              "items": {
                "$ref": "urn:awrad:goal-model:1#/$defs/count_entry"
              },
              "description": "Ordered by date, then session (null first, then by ID)."
            }
          }
        },
        "description": "One per given goal, in the same order."
      }
    }
  },
