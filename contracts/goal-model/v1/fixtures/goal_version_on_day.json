{
  "format": "awrad-fixture/1",
  "rule": "goal_version_on_day",
  "description": "Which dated version a goal document is judged by on a day, and the `goal` it resolves into: the version whose from is the latest on or before the day (the first version for earlier days), plus the document's pauses and excused days; an ended goal's end caps the active period.",
  "references": [
    "CONTEXT.md#goal-language (Dated version)",
    "docs/slices/04-goals-decisions.md decision 23",
    "docs/slices/04-goals.md (Domain and fixtures)"
  ],
  "given_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "document",
      "date"
    ],
    "properties": {
      "document": {
        "$ref": "urn:awrad:goal-model:1#/$defs/goal_document"
      },
      "date": {
        "$ref": "urn:awrad:goal-model:1#/$defs/date"
      }
    }
  },
  "expect_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "version",
      "goal"
    ],
    "properties": {
      "version": {
        "type": "integer",
        "minimum": 0,
        "maximum": 99,
        "description": "Index into the document's versions."
      },
      "goal": {
        "$ref": "urn:awrad:goal-model:1#/$defs/goal"
      }
    }
  },
