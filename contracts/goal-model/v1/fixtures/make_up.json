{
  "format": "awrad-fixture/1",
  "rule": "make_up",
  "description": "Each due day's status, with make-up (decisions 18 and 31): on a later day inside the missed day's window (the next day, or within 3 days), counts past what that day needs for itself (its target, or its streak amount if higher; all of a day's counts when it isn't due) fill missed days, oldest first, up to the fill amount (the streak amount, or the target and at least the streak amount). Paused and excused days neither fill nor are filled; days after the end don't fill. With sessions, each session fills only itself. Status: met, minimum_only (the streak amount but not the target), made_up, missed, or in_progress (today, below the streak amount).",
  "references": [
    "CONTEXT.md#goal-language (Make-up)",
    "docs/slices/04-goals-decisions.md decisions 17, 18, 22, 31 and 43"
  ],
  "given_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "goal",
      "counts",
      "date",
      "from"
    ],
    "properties": {
      "goal": {
        "$ref": "urn:awrad:goal-model:1#/$defs/goal_input"
      },
      "counts": {
        "type": "array",
        "items": {
          "$ref": "urn:awrad:goal-model:1#/$defs/count_entry"
        }
      },
      "date": {
        "$ref": "urn:awrad:goal-model:1#/$defs/date",
        "description": "Today: the effective practice day evaluated."
      },
      "from": {
        "$ref": "urn:awrad:goal-model:1#/$defs/date",
        "description": "The first day to list (the expectation lists due days from here to today, or to the goal's last day)."
      },
      "hijri_corrections": {
        "$ref": "urn:awrad:hijri-calendar:1#/$defs/corrections",
        "description": "The account's Hijri month-start corrections. Absent means none."
      }
    }
  },
  "expect_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "days"
    ],
    "properties": {
      "days": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "count",
            "filled",
            "status"
          ],
          "properties": {
            "date": {
              "$ref": "urn:awrad:goal-model:1#/$defs/date"
            },
            "count": {
              "$ref": "urn:awrad:goal-model:1#/$defs/count",
              "description": "The day's own count (with sessions, all of them)."
            },
            "filled": {
              "$ref": "urn:awrad:goal-model:1#/$defs/count",
              "description": "Made up from later days."
            },
            "status": {
              "enum": [
                "met",
                "minimum_only",
                "made_up",
                "missed",
                "in_progress"
              ]
            }
          }
        }
      }
    }
  },
