    "awrad-ios/awrad/awrad/Core/AwradCalculators.swift:21-66,189-228"
  ],
  "given_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "goal",
      "counts",
      "date",
      "week_start"
