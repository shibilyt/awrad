{
  "format": "awrad-fixture/1",
  "rule": "today_ring",
  "description": "What a goal's ring fills toward today in lists (decision 33: every ring means today). Daily goals and N days a period: today's target (with sessions, their targets combined, each session counting up to its own). Period totals: the week or month so far against its target. Totals: the streak amount, which is today's pace share for daily_pace (at least 1). Trackers: their streak number until it's reached; never with any count. No ring when today isn't due (for period totals: when the period has no due day).",
  "references": [
    "CONTEXT.md#goal-language (Daily pace, Tracking)",
    "docs/slices/04-goals-decisions.md decisions 11, 12, 28, 29, 30, 33 and 36"
  ],
  "given_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "goal",
      "counts",
      "date",
      "week_start"
    ],
    "properties": {
      "goal": {
        "$ref": "urn:awrad:goal-model:1#/$defs/goal_input"
      },
      "counts": {
        "type": "array",
        "items": {
          "$ref": "urn:awrad:goal-model:1#/$defs/count_entry"
        }
      },
      "date": {
        "$ref": "urn:awrad:goal-model:1#/$defs/date"
      },
      "week_start": {
        "$ref": "urn:awrad:goal-model:1#/$defs/week_start"
      },
      "hijri_corrections": {
        "$ref": "urn:awrad:hijri-calendar:1#/$defs/corrections",
        "description": "The account's Hijri month-start corrections. Absent means none."
      }
    }
  },
  "expect_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "ring",
      "progress",
      "goal"
    ],
    "properties": {
      "ring": {
        "enum": [
          "none",
          "target",
          "period_target",
          "pace",
          "streak_amount"
        ]
      },
      "progress": {
        "$ref": "urn:awrad:goal-model:1#/$defs/count",
        "description": "What fills the ring; with no ring, today's count."
      },
      "goal": {
        "oneOf": [
          {
            "$ref": "urn:awrad:goal-model:1#/$defs/count"
          },
          {
            "type": "null"
          }
        ],
        "description": "What a full ring is; null with no ring."
      }
    }
  },
