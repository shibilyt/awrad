{
  "format": "awrad-fixture/1",
  "rule": "daily_pace",
  "description": "Today's share of a total goal with an end (decision 28): what's left before today (the target, less every count from the start date to yesterday) divided by the due days from today to the last day, rounded up. Recalculated each day, never during it. null when the goal has no end, or today isn't due. Past days keep the end their version had, even after the goal is ended.",
  "references": [
    "CONTEXT.md#goal-language (Daily pace)",
    "docs/slices/04-goals-decisions.md decisions 28, 29 and 33"
  ],
  "given_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "goal",
      "counts",
      "date"
    ],
    "properties": {
      "goal": {
        "$ref": "urn:awrad:goal-model:1#/$defs/goal_input"
      },
      "counts": {
        "type": "array",
        "items": {
          "$ref": "urn:awrad:goal-model:1#/$defs/count_entry"
        }
      },
      "date": {
        "$ref": "urn:awrad:goal-model:1#/$defs/date"
      },
      "hijri_corrections": {
        "$ref": "urn:awrad:hijri-calendar:1#/$defs/corrections",
        "description": "The account's Hijri month-start corrections. Absent means none."
      }
    }
  },
  "expect_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "pace",
      "remaining",
      "due_days_left"
    ],
    "properties": {
      "pace": {
        "oneOf": [
          {
            "$ref": "urn:awrad:goal-model:1#/$defs/count"
          },
          {
            "type": "null"
          }
        ]
      },
      "remaining": {
        "$ref": "urn:awrad:goal-model:1#/$defs/count"
      },
      "due_days_left": {
        "oneOf": [
          {
            "$ref": "urn:awrad:goal-model:1#/$defs/count"
          },
          {
            "type": "null"
          }
        ],
        "description": "Due days from today (inclusive) to the last day; null without an end."
      }
    }
  },
