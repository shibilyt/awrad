{
  "format": "awrad-fixture/1",
  "rule": "excused_days",
  "description": "Whether a day can be excused or un-excused (decision 20). Excusing needs, in this order: a goal still running (goal_finished), a day before today (not_past), not already excused, a goal judged by day (not_available for period totals), a due day (not_due: off-schedule, paused, outside the active period), a missed day (not_missed: met, minimum only or made up; for days per period, a day that didn't qualify), and fewer than 2 excused days in that day's Gregorian month (limit_reached). Un-excusing needs a running goal and an excused day.",
  "references": [
    "CONTEXT.md#goal-language (Excused day)",
    "docs/slices/04-goals-decisions.md decisions 20, 22, 29, 30 and 43",
    "docs/slices/04-goals.md question 12"
  ],
  "given_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "goal",
      "counts",
      "date",
      "day",
      "action",
      "week_start"
    ],
    "properties": {
      "goal": {
        "$ref": "urn:awrad:goal-model:1#/$defs/goal_input"
      },
      "counts": {
        "type": "array",
        "items": {
          "$ref": "urn:awrad:goal-model:1#/$defs/count_entry"
        }
      },
      "date": {
        "$ref": "urn:awrad:goal-model:1#/$defs/date",
        "description": "Today."
      },
      "day": {
        "$ref": "urn:awrad:goal-model:1#/$defs/date",
        "description": "The day to excuse or un-excuse."
      },
      "action": {
        "enum": [
          "excuse",
          "unexcuse"
        ]
      },
      "week_start": {
        "$ref": "urn:awrad:goal-model:1#/$defs/week_start"
      },
      "hijri_corrections": {
        "$ref": "urn:awrad:hijri-calendar:1#/$defs/corrections",
        "description": "The account's Hijri month-start corrections. Absent means none."
      }
    }
  },
  "expect_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "allowed",
      "reason"
    ],
    "properties": {
      "allowed": {
        "type": "boolean"
      },
      "reason": {
        "enum": [
          null,
          "goal_finished",
          "not_past",
          "already_excused",
          "not_available",
          "not_due",
          "not_missed",
          "limit_reached",
          "not_excused"
        ],
        "description": "null when allowed; otherwise the first check that failed."
      }
    }
  },
