{
  "format": "awrad-fixture/1",
  "rule": "days_per_period",
  "description": "Days per period: how many qualifying days (a due day meeting the daily target; with sessions, every session) a week or month has, against the days required. The required number is capped by the due days the window actually has (a partial first week, pauses, a weekday schedule).",
  "references": [
    "CONTEXT.md#goal-language (Requirement: days per period)",
    "docs/slices/01-domain-foundation.md row 23, decision 3A"
  ],
  "given_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "goal",
      "counts",
      "date",
      "week_start"
    ],
    "properties": {
      "goal": {
        "$ref": "urn:awrad:goal-model:1#/$defs/goal"
      },
      "counts": {
        "type": "array",
        "items": {
          "$ref": "urn:awrad:goal-model:1#/$defs/count_entry"
        }
      },
      "date": {
        "$ref": "urn:awrad:goal-model:1#/$defs/date"
      },
      "week_start": {
        "$ref": "urn:awrad:goal-model:1#/$defs/week_start"
      },
      "hijri_corrections": {
        "$ref": "urn:awrad:hijri-calendar:1#/$defs/corrections",
        "description": "The account's Hijri month-start corrections. Absent means none."
      }
    }
  },
  "expect_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "status",
      "window",
      "qualifying_days",
      "required_days"
    ],
    "properties": {
      "status": {
        "enum": [
          "met",
          "not_met",
          "not_due"
        ]
      },
      "window": {
        "$ref": "urn:awrad:goal-model:1#/$defs/window"
      },
      "qualifying_days": {
        "type": "integer",
        "minimum": 0
      },
      "required_days": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
