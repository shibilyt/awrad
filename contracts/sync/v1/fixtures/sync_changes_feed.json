{
  "format": "awrad-fixture/1",
  "rule": "sync_changes_feed",
  "description": "The server side of list_sync_changes: given an account's entities (each at the revision of its last change) and the request's after and limit, the page. Changes are entities whose revision is above after, ordered by revision, entity_type, entity_id. after=0 lists only active entities; after>0 includes deletes. Whole revisions are added until the page holds at least limit changes, so a revision is never split. When more remain, has_more is true and next_after is the page's last revision; otherwise next_after is head_revision. The page is read in one consistent snapshot.",
  "references": [
    "docs/slices/03b-custom-dhikrs-sync.md#changes-feed-get-apiv1syncchangesafternlimit200",
    "contracts/sync/v1/README.md"
  ],
  "given_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "entities",
      "head_revision",
      "after",
      "limit"
    ],
    "properties": {
      "entities": {
        "type": "array",
        "items": {
          "$ref": "urn:awrad:sync:1#/$defs/change"
        }
      },
      "head_revision": {
        "$ref": "urn:awrad:sync:1#/$defs/revision"
      },
      "after": {
        "$ref": "urn:awrad:sync:1#/$defs/revision"
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 500
      }
    }
  },
  "expect_schema": {
    "$ref": "urn:awrad:sync:1#/$defs/changes_page"
  },
