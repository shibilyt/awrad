{
  "format": "awrad-fixture/1",
  "rule": "profile_switch",
  "description": "Who the data on a phone belongs to (Android and iOS). Given the profile registry, one event and the user's answer to any question it raises, the resulting registry, the question asked (`prompt`), the profile whose every entity is queued as a put (`queue_all`), the profile that syncs now (`sync`: send its queue, then pull), and the profiles erased. Events: `edit` (a saved change in the active profile), `sign_in`, `sign_out`, `remove_profile` (Settings, Remove from this device) and `account_deleted` (the phone learned the profile's account no longer exists). Rules: before any sign-in there is one anonymous profile whose edits are saved but never queued; the first sign-in asks `anonymous_data` only if that profile has data (`add_to_account` adopts it and queues everything, `erase` replaces it with a fresh profile) and otherwise adopts it silently; signing out keeps the active profile, whose later edits are queued but not sent; signing in as an account that has a profile reactivates it without a question; signing in as a new account creates its profile (`new_profile_id`) and leaves the others untouched; removing a profile with unsent changes asks `unsent_changes` first (`remove` or `cancel`); `account_deleted` asks to `remove` or `keep`; removing the active profile signs out and starts a fresh anonymous profile. A profile only syncs when the signed-in account equals its account, and every sync request carries that account in X-Awrad-Account. The scenario_NN cases are one story: each starts where the previous one ended.",
  "references": [
    "docs/slices/03b-custom-dhikrs-sync.md#clients-android-and-ios (Local profiles)",
    "contracts/sync/v1/README.md",
    "DECISIONS.md ADR-2026-10-28 (The change queue)",
    "DECISIONS.md ADR-2026-07-12 (accounts and device sessions)"
  ],
  "given_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "registry",
      "event",
      "choice",
      "new_profile_id"
    ],
    "properties": {
      "registry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profiles",
          "active_profile_id",
          "signed_in_account_id"
        ],
        "properties": {
          "profiles": {
            "description": "Every profile on the phone, in creation order. Each is its own local database.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "profile_id",
                "account_id",
                "email",
                "after",
                "has_data",
                "has_unsent"
              ],
              "properties": {
                "profile_id": {
                  "$ref": "urn:awrad:sync:1#/$defs/uuid",
                  "description": "Local ID, a UUIDv7 made on the phone."
                },
                "account_id": {
                  "oneOf": [
                    {
                      "$ref": "urn:awrad:sync:1#/$defs/uuid"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "null only for the anonymous profile."
                },
                "email": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "For display; null for the anonymous profile."
                },
                "after": {
                  "$ref": "urn:awrad:sync:1#/$defs/revision",
                  "description": "This profile's changes-feed position."
                },
                "has_data": {
                  "type": "boolean",
                  "description": "Holds at least one custom dhikr, tag or personal record."
                },
                "has_unsent": {
                  "type": "boolean",
                  "description": "Its queue holds commands not yet acknowledged."
                }
              }
            }
          },
          "active_profile_id": {
            "$ref": "urn:awrad:sync:1#/$defs/uuid"
          },
          "signed_in_account_id": {
            "oneOf": [
              {
                "$ref": "urn:awrad:sync:1#/$defs/uuid"
              },
              {
                "type": "null"
              }
            ]
