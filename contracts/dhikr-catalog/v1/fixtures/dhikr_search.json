{
  "format": "awrad-fixture/1",
  "rule": "dhikr_search",
  "description": "Searching the built-in catalog (contracts/dhikr-catalog/v1/catalog.json). Query and fields are normalized (dhikr_search_normalization) and then compacted by removing spaces. Names are every title (en, ar, ml) and every alias; other fields are the Arabic, every transliteration, and the translation in the app language and in English. A dhikr matches when the compact query is a substring of any name or other field. Rank 0: some name starts with the query; rank 1: any other match. Results are rank, then catalog order. A blank query returns every dhikr in catalog order.",
  "references": [
    "docs/slices/03a-dhikr-catalog.md#domain-and-fixtures-step-3",
    "awrad-android/app/src/main/java/app/awrad/awrad_dhikrgoalstracker/ui/screens/library/LibraryFilterPolicy.kt",
    "awrad-ios/awrad/awrad/Features/Library/LibraryFeatureModel.swift"
  ],
  "given_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "query",
      "language"
    ],
    "properties": {
      "query": {
        "type": "string"
      },
      "language": {
        "enum": [
          "en",
          "ar",
          "ml"
        ]
      }
    }
  },
  "expect_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "keys"
    ],
    "properties": {
      "keys": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "cases": [
    {
      "id": "alias_spelling_variant",
      "description": "A spelling people type finds the dhikr through its alias.",
      "given": {
        "query": "astaghfirullah",
        "language": "en"
      },
      "expect": {
        "keys": [
          "isthighfar"
        ]
      }
    },
    {
      "id": "arabic_query_without_harakat",
      "description": "Arabic typed without harakat matches vocalized text and aliases.",
      "given": {
        "query": "أستغفر الله",
        "language": "ar"
      },
      "expect": {
        "keys": [
          "isthighfar",
          "ramadan-dhikr"
        ]
      }
    },
    {
      "id": "case_insensitive_title",
      "description": "Upper case matches the title.",
      "given": {
        "query": "ISTHIGHFAR",
        "language": "en"
      },
      "expect": {
        "keys": [
          "isthighfar"
        ]
      }
    },
    {
      "id": "name_prefix_ranks_first",
      "description": "A name starting with the query ranks before a transliteration containing it.",
      "given": {
        "query": "rahman",
        "language": "en"
      },
      "expect": {
        "keys": [
          "asma-ul-husna-ar-rahman",
          "surah-ikhlas"
        ]
      }
    },
    {
      "id": "spaces_ignored",
      "description": "Spaces and hyphens don't matter.",
      "given": {
        "query": "Ar Rahman",
        "language": "en"
      },
      "expect": {
        "keys": [
          "asma-ul-husna-ar-rahman"
        ]
      }
    },
    {
      "id": "arabic_name_and_basmala",
      "description": "An Arabic name matches the name and any text that contains it.",
      "given": {
        "query": "الرحمن",
        "language": "ar"
      },
      "expect": {
        "keys": [
          "asma-ul-husna-ar-rahman",
          "surah-ikhlas"
        ]
      }
    },
    {
      "id": "malayalam_without_zwnj",
      "description": "Malayalam typed without ZWNJ matches the title.",
      "given": {
        "query": "തഹ്ലീൽ",
        "language": "ml"
      },
      "expect": {
        "keys": [
          "tahleel"
        ]
      }
    },
    {
      "id": "malayalam_translation",
      "description": "A word from the Malayalam translation matches in Malayalam.",
      "given": {
        "query": "പാപമോചനം",
        "language": "ml"
      },
      "expect": {
        "keys": [
          "isthighfar",
          "ramadan-dhikr"
        ]
      }
    },
    {
      "id": "english_translation",
      "description": "A word from the English translation matches.",
      "given": {
        "query": "forgiveness",
        "language": "en"
      },
      "expect": {
        "keys": [
          "isthighfar",
          "ramadan-dhikr"
        ]
      }
    },
    {
      "id": "shared_prefix_keeps_catalog_order",
      "description": "Several names with the same prefix keep catalog order.",
      "given": {
        "query": "swalath",
        "language": "en"
      },
      "expect": {
        "keys": [
          "swalath-al-fathimiyya",
          "swalath",
          "swalath-sayyidina",
          "swalath-al-fatih",
          "swalath-al-nariyya",
          "swalath-for-debt"
        ]
      }
    },
    {
      "id": "alias_inside_name",
      "description": "A phrase inside an alias matches.",
      "given": {
        "query": "for debt",
        "language": "en"
      },
      "expect": {
        "keys": [
          "swalath-for-debt"
        ]
      }
    },
    {
      "id": "spelling_variant_alias",
      "description": "The salli spelling finds the swalli title through its alias.",
      "given": {
        "query": "Allahumma salli",
        "language": "en"
      },
      "expect": {
        "keys": [
          "swalath-sayyidina"
        ]
      }
    },
    {
      "id": "arabic_phrase_in_text",
      "description": "An Arabic phrase inside several texts.",
      "given": {
        "query": "سيدنا محمد",
        "language": "ar"
      },
      "expect": {
        "keys": [
          "swalath-sayyidina",
          "swalath-al-fatih",
          "swalath-al-nariyya"
        ]
      }
    },
    {
      "id": "duplicate_text_both_found",
      "description": "Two identities with the same text are both found.",
      "given": {
        "query": "ya wahhab",
        "language": "en"
      },
      "expect": {
        "keys": [
          "ya-wahhabu",
          "asma-ul-husna-al-wahhab"
        ]
      }
    },
    {
      "id": "no_match",
      "description": "Nothing matches.",
      "given": {
        "query": "xyzzy",
        "language": "en"
      },
      "expect": {
        "keys": []
      }
    },
    {
      "id": "blank_query_lists_everything",
