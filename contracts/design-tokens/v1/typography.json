{
  "version": 1,
  "description": "Text styles. Interface text uses fontFamily (fonts/README.md); a style with its own fontFamily overrides it. Arabic and Malayalam interface text falls back to the system font. Sizes in sp / pt / CSS px; iOS scales each style with Dynamic Type relative to iosTextStyle.",
  "fontFamily": "Google Sans Flex Rounded",
  "styles": {
    "largeTitle": {
      "size": 34,
      "lineHeight": 40,
      "weight": 700,
      "iosTextStyle": "largeTitle",
      "use": "Top-level page titles: My Goals"
    },
    "title": {
      "size": 22,
      "lineHeight": 28,
      "weight": 600,
      "iosTextStyle": "title2",
      "use": "Screen titles; the Hijri date on Home"
    },
    "cardTitle": {
      "size": 18,
      "lineHeight": 24,
      "weight": 600,
      "iosTextStyle": "title3",
      "use": "Card headings: Today's goals"
    },
    "rowTitle": {
      "size": 16,
      "lineHeight": 22,
      "weight": 600,
      "iosTextStyle": "headline",
      "use": "Row titles: a goal's name"
    },
    "sectionTitle": {
      "size": 15,
      "lineHeight": 20,
      "weight": 600,
      "iosTextStyle": "subheadline",
      "use": "Section headings: Featured dhikr collections"
    },
    "body": {
      "size": 15,
      "lineHeight": 22,
      "weight": 400,
      "iosTextStyle": "body",
      "use": "Paragraphs and form text"
    },
    "input": {
      "size": 16,
      "lineHeight": 22,
      "weight": 400,
      "iosTextStyle": "body",
      "use": "Text typed into fields (16 stops iOS Safari zooming in)"
    },
    "bodySmall": {
      "size": 14,
      "lineHeight": 20,
      "weight": 400,
      "iosTextStyle": "subheadline",
      "use": "Secondary text: the Gregorian date, Next prayer"
    },
    "label": {
      "size": 14,
      "lineHeight": 20,
      "weight": 500,
      "iosTextStyle": "subheadline",
      "use": "Links and small buttons: View all"
    },
    "button": {
      "size": 16,
      "lineHeight": 22,
      "weight": 600,
      "iosTextStyle": "headline",
      "use": "Main buttons"
    },
    "caption": {
      "size": 12,
      "lineHeight": 16,
      "weight": 500,
      "iosTextStyle": "caption",
      "use": "Streaks, counts, metadata"
    },
    "navLabel": {
      "size": 11,
      "lineHeight": 14,
      "weight": 500,
      "iosTextStyle": "caption2",
      "use": "Bottom navigation labels"
    },
    "counter": {
      "size": 56,
      "lineHeight": 64,
      "weight": 700,
      "iosTextStyle": "largeTitle",
      "tabularNumbers": true,
      "use": "The counting number. The 64 line height is tighter than the font's natural 70 on purpose"
    },
    "quran": {
      "fontFamily": "Noto Naskh Arabic",
      "size": 24,
      "lineHeight": 44,
      "weight": 400,
      "iosTextStyle": "title2",
      "use": "Qur'anic and dhikr Arabic text; never interface text"
    },
    "quranLine": {
      "fontFamily": "Noto Naskh Arabic",
      "size": 18,
      "lineHeight": 32,
      "weight": 400,
      "iosTextStyle": "body",
      "use": "One line of Qur'anic or dhikr Arabic in a list row; never interface text"
    },
    "nameOfAllah": {
      "fontFamily": "Noto Naskh Arabic",
      "size": 40,
      "lineHeight": 64,
      "weight": 400,
      "iosTextStyle": "largeTitle",
      "use": "A name of Allah shown on its own (dhikr detail); never interface text"
    }
  }
}
