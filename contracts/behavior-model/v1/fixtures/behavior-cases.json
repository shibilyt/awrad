  "tag_normalization": [
    {
      "id": "trim_collapse_casefold",
      "input": "  Before   Sleep  ",
      "expected_display": "Before Sleep",
      "expected_normalized": "before sleep"
    },
    {
      "id": "nfc_and_casefold",
      "input": "Beforé Sleep",
      "expected_display": "Beforé Sleep",
      "expected_normalized": "beforé sleep",
      "notes": "Combining marks are NFC-normalized for display; uniqueness uses locale-independent Unicode Default Case Folding without stripping diacritics or Arabic marks. Full White_Space / ß↔SS / dotted-I fixtures live in tag-normalization-contract.json."
    },
    {
      "id": "arabic_marks_preserved",
      "input_a": "سَلام",
      "input_b": "سلام",
      "expected_same_normalized": false
    },
    {
      "id": "reject_empty_and_oversized",
      "cases": [
        {"input": "   ", "accepted": false},
        {"input": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "accepted": false, "reason": "over_40_graphemes"},
        {"input": "Sleep", "accepted": true}
      ]
    },
    {
      "id": "sharp_s_full_casefold",
      "input_a": "Straße",
      "input_b": "STRASSE",
      "expected_same_normalized": true,
      "expected_normalized": "strasse",
      "notes": "Unicode full casefold maps ß→ss so Straße and STRASSE collide."
    },
    {
      "id": "dotted_i_full_casefold",
      "input": "İstanbul",
      "expected_display": "İstanbul",
      "expected_normalized": "i\u0307stanbul",
      "notes": "Non-Turkic full casefold maps U+0130 to i + combining dot above (not Turkish i)."
    },
    {
      "id": "unicode_whitespace_collapse",
      "input": "Before\u202F\u202FSleep\u2007Night",
      "expected_display": "Before Sleep Night",
      "expected_normalized": "before sleep night",
      "notes": "NNBSP (U+202F) and figure space (U+2007) collapse like other Unicode Zs whitespace."
    }
