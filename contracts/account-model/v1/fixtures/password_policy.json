{
  "format": "awrad-fixture/1",
  "rule": "password_policy",
  "description": "The password length rule: 12 to 128 Unicode code points after NFC normalisation, nothing trimmed, no composition rules. Clients check only this; the server also rejects common passwords (password_too_common), which isn't part of this rule.",
  "references": [
    "docs/slices/02-accounts.md (decisions 2, 3)",
    "contracts/api/openapi.yaml (Email, Password, EmailCode)"
  ],
  "given_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "password"
    ],
    "properties": {
      "password": {
        "type": "string"
      }
    }
  },
  "expect_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "valid",
      "errors"
    ],
    "properties": {
      "valid": {
        "type": "boolean"
      },
      "errors": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "enum": [
            "password_too_short",
            "password_too_long"
          ]
        }
      }
    }
  },
  "cases": [
    {
      "id": "eleven",
      "description": "11 characters is too short.",
      "given": {
        "password": "aaaaaaaaaaa"
      },
      "expect": {
        "valid": false,
        "errors": [
          "password_too_short"
        ]
      }
    },
    {
      "id": "twelve",
      "description": "12 characters is enough.",
      "given": {
        "password": "aaaaaaaaaaaa"
      },
      "expect": {
        "valid": true,
        "errors": []
      }
    },
    {
      "id": "all_lowercase_passphrase",
      "description": "No composition rules.",
      "given": {
        "password": "dhikr every morning"
      },
      "expect": {
        "valid": true,
        "errors": []
      }
    },
    {
      "id": "spaces_count",
      "description": "Spaces count and aren't trimmed: 10 letters + 2 spaces.",
      "given": {
        "password": " abcdefghij "
      },
      "expect": {
        "valid": true,
        "errors": []
      }
    },
    {
      "id": "max",
      "description": "128 characters.",
      "given": {
        "password": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect": {
        "valid": true,
        "errors": []
      }
    },
    {
      "id": "too_long",
      "description": "129 characters.",
      "given": {
        "password": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "expect": {
        "valid": false,
        "errors": [
          "password_too_long"
        ]
      }
    },
    {
      "id": "arabic",
      "description": "12 Arabic letters.",
      "given": {
        "password": "سبحان الله و"
      },
      "expect": {
        "valid": true,
        "errors": []
      }
    },
    {
      "id": "emoji_counted_as_one",
      "description": "6 emoji are 6 code points (12 UTF-16 units): too short.",
      "given": {
        "password": "😀😀😀😀😀😀"
      },
      "expect": {
        "valid": false,
        "errors": [
          "password_too_short"
        ]
      }
    },
    {
      "id": "twelve_emoji",
      "description": "12 emoji are 12 code points.",
      "given": {
        "password": "😀😀😀😀😀😀😀😀😀😀😀😀"
      },
      "expect": {
        "valid": true,
        "errors": []
      }
    },
    {
      "id": "combining_marks_normalised",
      "description": "6 × e + combining acute become 6 × é after NFC: too short.",
      "given": {
        "password": "éééééé"
      },
      "expect": {
        "valid": false,
        "errors": [
          "password_too_short"
        ]
      }
    },
    {
      "id": "zwj_sequence_counts_code_points",
      "description": "A family emoji is 5 code points; three of them are 15.",
      "given": {
        "password": "👨‍👩‍👧👨‍👩‍👧👨‍👩‍👧"
      },
      "expect": {
        "valid": true,
        "errors": []
      }
    },
    {
      "id": "empty",
      "description": "Empty.",
      "given": {
        "password": ""
      },
      "expect": {
        "valid": false,
        "errors": [
          "password_too_short"
        ]
      }
    }
  ]
}
