# Environment for the production release. Copy the keys into the Dokploy
# application's Environment tab; never commit real values.

# Dokploy-managed Postgres. Use the internal service hostname, not localhost.
DATABASE_URL=ecto://awrad:CHANGE_ME@awrad-postgres:5432/awrad_api_prod
POOL_SIZE=10

# Public API hostname used by mobile clients and app-association files.
PHX_HOST=api.example.com
# Browser-facing hostname for the web companion. There is no marketing site.
WEB_HOST=example.com
PORT=4000

# Resend transactional email. Verify the sender domain in Resend first.
RESEND_API_KEY=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Awrad

# mix phx.gen.secret
SECRET_KEY_BASE=
# mix phx.gen.secret — each must be at least 32 bytes
JWT_SIGNING_SECRET=
REFRESH_RETRY_SECRET=
AUTH_RATE_LIMIT_PEPPER=

# Optional: set this when Android App Links are ready for the signed build.
# ANDROID_APP_LINK_SHA256_CERT_FINGERPRINTS=AA:BB:CC:...:FF
# Optional: set this when an iOS app is ready for Universal Links.
# IOS_APP_TEAM_ID=ABCDE12345

# Optional operational switches.
# PROGRESS_SYNC_ENABLED=true
# PROGRESS_SYNC_MAINTENANCE_ENABLED=true
# ECTO_IPV6=false
# DNS_CLUSTER_QUERY=
