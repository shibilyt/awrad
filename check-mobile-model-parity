#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

python3 "$ROOT/scripts/generate_asma_ul_husna.py" --check
python3 "$ROOT/scripts/generate_wird_model.py" --check
python3 "$ROOT/scripts/validate_progress_contract.py"
python3 "$ROOT/scripts/validate_progress_sync.py"
python3 "$ROOT/scripts/validate_behavior_fixtures.py"

(
  cd "$ROOT/awrad-android"
  ./gradlew :app:testDebugUnitTest \
    --tests 'app.awrad.awrad_dhikrgoalstracker.data.contract.v1.ProgressContractV1Test' \
    --tests 'app.awrad.awrad_dhikrgoalstracker.data.wird.WirdModelTest' \
    --tests 'app.awrad.awrad_dhikrgoalstracker.util.BehaviorFixtureParityTest' \
    --console=plain
)

IOS_DESTINATION="${AWRAD_IOS_TEST_DESTINATION:-}"
if [[ -z "$IOS_DESTINATION" ]]; then
  IOS_UDID="$(xcrun simctl list devices available -j | python3 -c '
import json, sys
devices = json.load(sys.stdin)["devices"]
for runtime in sorted(devices, reverse=True):
    for device in devices[runtime]:
        if device.get("isAvailable") and device.get("name", "").startswith("iPhone"):
            print(device["udid"])
            raise SystemExit(0)
raise SystemExit("No available iPhone simulator found; set AWRAD_IOS_TEST_DESTINATION")
')"
  IOS_DESTINATION="platform=iOS Simulator,id=$IOS_UDID"
fi

(
  cd "$ROOT/awrad-ios/awrad"
  xcodebuild \
    -project awrad.xcodeproj \
    -scheme awrad \
    -destination "$IOS_DESTINATION" \
    -parallel-testing-enabled NO \
    -only-testing:awradTests/ProgressContractV1Tests \
    -only-testing:awradTests/WirdContractV1Tests \
    -only-testing:awradTests/BehaviorParityTests \
    test
)
