    "account.notice.account_deleted" : {
      "comment" : "Notice on sign in after the account was deleted.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم حذف حسابك. كل ما على هذا الجهاز ما زال موجودًا." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your account was deleted. Everything on this device is still here." } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "നിങ്ങളുടെ അക്കൗണ്ട് ഇല്ലാതാക്കി. ഈ ഉപകരണത്തിലുള്ളതെല്ലാം ഇപ്പോഴും ഇവിടെയുണ്ട്." } }
      }
