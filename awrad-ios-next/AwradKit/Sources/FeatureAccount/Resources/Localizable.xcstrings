{
  "sourceLanguage" : "en",
  "strings" : {
    "account.cancel" : {
      "comment" : "Button that closes a confirmation without doing anything.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "إلغاء" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "റദ്ദാക്കുക" } }
      }
    },
    "account.change_email.body" : {
      "comment" : "Explains how changing the email works.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "سنرسل رمزًا إلى العنوان الجديد. لن يتغيّر بريدك الإلكتروني إلا بعد إدخاله." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "We'll email a code to the new address. Your email changes only once you enter it." } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "പുതിയ വിലാസത്തിലേക്ക് ഞങ്ങൾ ഒരു കോഡ് അയയ്ക്കും. അത് നൽകിയാൽ മാത്രമേ നിങ്ങളുടെ ഇമെയിൽ മാറുകയുള്ളൂ." } }
      }
    },
    "account.change_email.button" : {
      "comment" : "Primary button on the change-email screen: emails a code to the new address.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "إرسال الرمز" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Send code" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "കോഡ് അയയ്ക്കുക" } }
      }
    },
    "account.change_email.title" : {
      "comment" : "Title of the change-email screen.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تغيير البريد الإلكتروني" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Change email" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "ഇമെയിൽ മാറ്റുക" } }
      }
    },
    "account.change_password.body" : {
      "comment" : "Explains what changing the password does.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "سيتم تسجيل الخروج من أجهزتك ومتصفحاتك الأخرى. يبقى هذا الجهاز مسجّل الدخول." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your other devices and browsers will be signed out. This one stays signed in." } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "നിങ്ങളുടെ മറ്റ് ഉപകരണങ്ങളും ബ്രൗസറുകളും സൈൻ ഔട്ട് ചെയ്യപ്പെടും. ഇത് സൈൻ ഇൻ ആയി തുടരും." } }
      }
    },
    "account.change_password.button" : {
      "comment" : "Primary button on the change-password screen.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تغيير كلمة المرور" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Change password" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "പാസ്‌വേഡ് മാറ്റുക" } }
      }
    },
    "account.change_password.title" : {
      "comment" : "Title of the change-password screen.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تغيير كلمة المرور" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Change password" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "പാസ്‌വേഡ് മാറ്റുക" } }
      }
    },
    "account.confirm_email.body %lld %lld" : {
      "comment" : "Explains the code for the new email; the new address is shown on its own line below. The numbers are the code length (6) and the minutes it works (15).",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "أدخل الرمز المكوّن من %1$lld أرقام الذي أرسلناه إلى هذا العنوان. الرمز صالح لمدة %2$lld دقيقة." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter the %1$lld-digit code we sent to this address. It works for %2$lld minutes." } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "ഈ വിലാസത്തിലേക്ക് ഞങ്ങൾ അയച്ച %1$lld അക്ക കോഡ് നൽകുക. ഇത് %2$lld മിനിറ്റ് സാധുവാണ്." } }
      }
    },
    "account.confirm_email.button" : {
      "comment" : "Primary button that confirms the new email with the code.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تغيير البريد الإلكتروني" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Change email" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "ഇമെയിൽ മാറ്റുക" } }
      }
    },
    "account.confirm_email.title" : {
      "comment" : "Title of the screen that takes the code sent to the new email.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تأكيد بريدك الإلكتروني الجديد" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Confirm your new email" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "നിങ്ങളുടെ പുതിയ ഇമെയിൽ സ്ഥിരീകരിക്കുക" } }
      }
    },
    "account.delete.body" : {
      "comment" : "Explains what deleting the account does on the server.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يُحذف حسابك وكل ما يحفظه أوراد له على الخادم فورًا، ويُسجَّل الخروج من جميع الأجهزة والمتصفحات. لا يمكن التراجع عن ذلك." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your account and everything Awrad keeps for it on the server are deleted right away, and every device and browser is signed out. This can't be undone." } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "നിങ്ങളുടെ അക്കൗണ്ടും സെർവറിൽ Awrad അതിനായി സൂക്ഷിക്കുന്നതെല്ലാം ഉടൻ ഇല്ലാതാക്കപ്പെടും, എല്ലാ ഉപകരണങ്ങളും ബ്രൗസറുകളും സൈൻ ഔട്ട് ആകും. ഇത് പഴയപടിയാക്കാനാവില്ല." } }
      }
    },
    "account.delete.button" : {
      "comment" : "Destructive button on the delete-account screen; asks for confirmation next.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "حذف الحساب" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete account" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "അക്കൗണ്ട് ഇല്ലാതാക്കുക" } }
      }
    },
    "account.delete.local_note" : {
      "comment" : "Explains that deleting the account keeps the data on this device.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تبقى أذكارك وأهدافك وأعدادك على هذا الجهاز، ويستمر التطبيق في العمل بدون حساب." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your dhikr, goals and counts on this device stay, and the app keeps working without an account." } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "ഈ ഉപകരണത്തിലെ നിങ്ങളുടെ ദിക്റുകളും ലക്ഷ്യങ്ങളും എണ്ണങ്ങളും നിലനിൽക്കും, അക്കൗണ്ടില്ലാതെയും ആപ്പ് പ്രവർത്തിക്കും." } }
      }
    },
    "account.delete.title" : {
      "comment" : "Title of the delete-account screen.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "حذف الحساب" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete account" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "അക്കൗണ്ട് ഇല്ലാതാക്കുക" } }
      }
    },
    "account.delete_confirm.button" : {
      "comment" : "Destructive button that deletes the account.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "حذف" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "ഇല്ലാതാക്കുക" } }
      }
    },
    "account.delete_confirm.message" : {
      "comment" : "Message of the last confirmation before deleting the account.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "سيُحذف الآن نهائيًا. تبقى البيانات على هذا الجهاز." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "It's deleted now, for good. Data on this device stays." } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "ഇത് ഇപ്പോൾ തന്നെ സ്ഥിരമായി ഇല്ലാതാകും. ഈ ഉപകരണത്തിലെ വിവരങ്ങൾ നിലനിൽക്കും." } }
      }
    },
    "account.delete_confirm.title" : {
      "comment" : "Title of the last confirmation before deleting the account.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "هل تريد حذف حسابك؟" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete your account?" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "നിങ്ങളുടെ അക്കൗണ്ട് ഇല്ലാതാക്കണോ?" } }
      }
    },
    "account.devices.body" : {
      "comment" : "Explains the devices screen.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الأماكن التي سُجّل فيها الدخول إلى حسابك: الهواتف والأجهزة اللوحية والمتصفحات. تسجيل الخروج من أحدها يُبقي بيانات وِردك عليه." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Where your account is signed in: phones, tablets and browsers. Signing one out leaves its practice data on it." } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "നിങ്ങളുടെ അക്കൗണ്ട് സൈൻ ഇൻ ചെയ്തിരിക്കുന്ന ഇടങ്ങൾ: ഫോണുകൾ, ടാബ്‌ലെറ്റുകൾ, ബ്രൗസറുകൾ. ഒന്നിൽ നിന്ന് സൈൻ ഔട്ട് ചെയ്താലും അതിലെ പരിശീലന വിവരങ്ങൾ അവിടെ തന്നെ ഉണ്ടാകും." } }
      }
    },
    "account.devices.last_used %@" : {
      "comment" : "When a session was last used. The argument is a relative time such as \"5 minutes ago\" or \"yesterday\".",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "آخر استخدام: %@" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Last used %@" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "അവസാനം ഉപയോഗിച്ചത്: %@" } }
      }
    },
    "account.devices.platform.android" : {
      "comment" : "Platform of a session: Android.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "أندرويد" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Android" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "ആൻഡ്രോയിഡ്" } }
      }
    },
    "account.devices.platform.ios" : {
      "comment" : "Platform of a session: iPhone or iPad.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "آيفون أو آيباد" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "iPhone or iPad" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "ഐഫോൺ അല്ലെങ്കിൽ ഐപാഡ്" } }
      }
    },
    "account.devices.platform.other" : {
      "comment" : "Platform of a session this version of the app doesn't know.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "أخرى" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Other" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "മറ്റുള്ളവ" } }
      }
    },
    "account.devices.platform.web" : {
      "comment" : "Platform of a session: a web browser.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الويب" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Web" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "വെബ്" } }
      }
    },
    "account.devices.retry" : {
      "comment" : "Button that loads the devices list again after it failed.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "حاول مرة أخرى" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Try again" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "വീണ്ടും ശ്രമിക്കുക" } }
      }
    },
    "account.devices.revoke" : {
      "comment" : "Button on a device row, and in its confirmation, that signs that device out.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تسجيل الخروج" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sign out" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "സൈൻ ഔട്ട് ചെയ്യുക" } }
      }
    },
    "account.devices.revoke_confirm.message" : {
      "comment" : "Confirmation message before signing a device out.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "سيحتاج إلى تسجيل الدخول مرة أخرى لاستخدام حسابك. تبقى بيانات وِردك عليه." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "It will have to sign in again to use your account. Its practice data stays on it." } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "നിങ്ങളുടെ അക്കൗണ്ട് ഉപയോഗിക്കാൻ അതിൽ വീണ്ടും സൈൻ ഇൻ ചെയ്യേണ്ടിവരും. അതിലെ പരിശീലന വിവരങ്ങൾ അവിടെ തന്നെ ഉണ്ടാകും." } }
      }
    },
    "account.devices.revoke_confirm.title %@" : {
      "comment" : "Confirmation title before signing a device out. The argument is the device or browser name.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تسجيل الخروج من %@؟" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sign out %@?" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "%@ സൈൻ ഔട്ട് ചെയ്യണോ?" } }
      }
    },
    "account.devices.sign_out_others" : {
      "comment" : "Button that signs out every device and browser except this one.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تسجيل الخروج من جميع الأجهزة الأخرى" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sign out of all other devices" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "മറ്റെല്ലാ ഉപകരണങ്ങളിൽ നിന്നും സൈൻ ഔട്ട് ചെയ്യുക" } }
      }
    },
    "account.devices.sign_out_others_confirm.button" : {
      "comment" : "Destructive button that confirms signing out every other device.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تسجيل خروج الأجهزة الأخرى" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sign out others" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "മറ്റുള്ളവ സൈൻ ഔട്ട് ചെയ്യുക" } }
      }
    },
    "account.devices.sign_out_others_confirm.message" : {
      "comment" : "Confirmation message before signing out every other device.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "ستحتاج جميع الهواتف والأجهزة اللوحية والمتصفحات الأخرى إلى تسجيل الدخول مرة أخرى. يبقى هذا الجهاز مسجّل الدخول." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Every other phone, tablet and browser will have to sign in again. This device stays signed in." } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "മറ്റെല്ലാ ഫോണുകളിലും ടാബ്‌ലെറ്റുകളിലും ബ്രൗസറുകളിലും വീണ്ടും സൈൻ ഇൻ ചെയ്യേണ്ടിവരും. ഈ ഉപകരണം സൈൻ ഇൻ ആയി തുടരും." } }
      }
    },
    "account.devices.sign_out_others_confirm.title" : {
      "comment" : "Confirmation title before signing out every other device.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تسجيل الخروج من جميع الأجهزة الأخرى؟" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sign out of all other devices?" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "മറ്റെല്ലാ ഉപകരണങ്ങളിൽ നിന്നും സൈൻ ഔട്ട് ചെയ്യണോ?" } }
      }
    },
    "account.devices.this_device" : {
      "comment" : "Marks the session of the device in hand in the devices list.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "هذا الجهاز" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "This device" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "ഈ ഉപകരണം" } }
      }
    },
    "account.devices.title" : {
      "comment" : "Title of the devices screen.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الأجهزة" } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Devices" } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "ഉപകരണങ്ങൾ" } }
      }
    },
    "account.devices.unknown_device" : {
      "comment" : "Name of a device session when the server couldn't tell which device.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "جهاز غير معروف" } },
