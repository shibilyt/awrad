        "ml" : { "stringUnit" : { "state" : "translated", "value" : "അക്കൗണ്ട് ഇല്ലാതാക്കുക" } }
      }
    },
    "account.overview.devices" : {
      "comment" : "Row on the account screen that opens the list of signed-in devices.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "الأجهزة" } },
