    "account.reset.body" : {
      "comment" : "Explains the reset screen; the email address is shown on its own line below.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "أدخل الرمز الذي أرسلناه إلى هذا العنوان وكلمة مرور جديدة. سيؤدي ذلك إلى تسجيل خروجك من جميع أجهزتك." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Enter the code we sent to this address and a new password. This signs you out on all your devices." } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "ഈ വിലാസത്തിലേക്ക് ഞങ്ങൾ അയച്ച കോഡും പുതിയ പാസ്‌വേഡും നൽകുക. ഇത് നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിൽ നിന്നും സൈൻ ഔട്ട് ചെയ്യും." } }
      }
    },
    "account.reset.button" : {
