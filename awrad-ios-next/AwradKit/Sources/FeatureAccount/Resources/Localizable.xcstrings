    "account.notice.code_sent" : {
      "comment" : "Notice: an email with a code is on its way.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "أرسلنا إليك رمزًا عبر البريد الإلكتروني. تحقّق من صندوق الوارد." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "We've emailed you a code. Check your inbox." } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "ഞങ്ങൾ നിങ്ങൾക്ക് ഒരു കോഡ് ഇമെയിൽ ചെയ്തിട്ടുണ്ട്. ഇൻബോക്സ് പരിശോധിക്കുക." } }
      }
    },
    "account.notice.email_changed" : {
      "comment" : "Notice after the email change is confirmed.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم تغيير بريدك الإلكتروني." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your email has been changed." } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "നിങ്ങളുടെ ഇമെയിൽ മാറ്റി." } }
      }
    },
    "account.notice.other_sessions_signed_out" : {
      "comment" : "Notice after signing out every other device.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم تسجيل الخروج من جميع الأجهزة الأخرى." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "All other devices were signed out." } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "മറ്റെല്ലാ ഉപകരണങ്ങളും സൈൻ ഔട്ട് ചെയ്തു." } }
      }
    },
    "account.notice.password_changed" : {
      "comment" : "Notice after changing the password.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم تغيير كلمة المرور. تم تسجيل الخروج من أجهزتك ومتصفحاتك الأخرى." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Password changed. Your other devices and browsers were signed out." } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "പാസ്‌വേഡ് മാറ്റി. നിങ്ങളുടെ മറ്റ് ഉപകരണങ്ങളും ബ്രൗസറുകളും സൈൻ ഔട്ട് ചെയ്യപ്പെട്ടു." } }
      }
    },
    "account.notice.session_signed_out" : {
      "comment" : "Notice after signing one device out.",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم تسجيل الخروج من ذلك الجهاز." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "That device was signed out." } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "ആ ഉപകരണം സൈൻ ഔട്ട് ചെയ്തു." } }
      }
    },
    "account.notice.verification_needed" : {
      "comment" : "Notice after signing in with an unverified email (email_verification_required).",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "أكّد بريدك الإلكتروني لتسجيل الدخول. أرسلنا إليك رمزًا جديدًا." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Verify your email to sign in. We've emailed you a new code." } },
        "ml" : { "stringUnit" : { "state" : "translated", "value" : "സൈൻ ഇൻ ചെയ്യാൻ നിങ്ങളുടെ ഇമെയിൽ സ്ഥിരീകരിക്കുക. ഞങ്ങൾ നിങ്ങൾക്ക് പുതിയൊരു കോഡ് ഇമെയിൽ ചെയ്തിട്ടുണ്ട്." } }
      }
    },
    "account.overview.change_email" : {
