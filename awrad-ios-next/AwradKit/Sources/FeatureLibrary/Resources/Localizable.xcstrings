    "library.delete_dhikr.message" : {
      "comment" : "Message of the confirmation for deleting a custom dhikr.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُحذف من مكتبتك ومن كل جهاز سجّلت الدخول منه. لا يمكن التراجع عن ذلك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's deleted from your library and from every device you're signed in on. This can't be undone."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇത് നിങ്ങളുടെ ലൈബ്രറിയിൽ നിന്നും സൈൻ ഇൻ ചെയ്ത എല്ലാ ഉപകരണങ്ങളിൽ നിന്നും ഇല്ലാതാകും. ഇത് തിരികെ എടുക്കാനാവില്ല."
          }
        }
      }
    },
    "library.delete_dhikr.title" : {
      "comment" : "Title of the confirmation for deleting a custom dhikr.",
