    "library.conflict.body" : {
      "comment" : "Explains a conflict between two devices.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تغيير هذا هنا وعلى جهاز آخر. اختر النسخة التي تريد الاحتفاظ بها."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This was changed here and on another device. Choose which version to keep."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇത് ഇവിടെയും മറ്റൊരു ഉപകരണത്തിലും മാറ്റിയിട്ടുണ്ട്. ഏത് പതിപ്പ് നിലനിർത്തണമെന്ന് തിരഞ്ഞെടുക്കുക."
          }
        }
      }
    },
    "library.conflict.keep_mine" : {
      "comment" : "Resolves a conflict with this device's version.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظ بنسختي"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep mine"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "എന്റേത് നിലനിർത്തുക"
          }
        }
      }
    },
    "library.conflict.title" : {
      "comment" : "Title of the card shown when a dhikr or tag was changed on two devices.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم التغيير على جهاز آخر"
