    "library.notice.reason.audio" : {
      "comment" : "Why a change came back from the server: its recording wasn't in the account. The change was kept, not undone.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتُفظ بتغييرك، لكن تسجيله لم يكن في حسابك. إن كان التسجيل لا يزال على هذا الهاتف فسيُرفع من جديد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your change was kept, but its recording wasn't in your account. If the recording is still on this phone, it uploads again."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ മാറ്റം നിലനിർത്തി, പക്ഷേ അതിന്റെ റെക്കോർഡിംഗ് നിങ്ങളുടെ അക്കൗണ്ടിൽ ഉണ്ടായിരുന്നില്ല. റെക്കോർഡിംഗ് ഇപ്പോഴും ഈ ഫോണിലുണ്ടെങ്കിൽ, അത് വീണ്ടും അപ്‌ലോഡ് ചെയ്യും."
          }
        }
      }
    },
