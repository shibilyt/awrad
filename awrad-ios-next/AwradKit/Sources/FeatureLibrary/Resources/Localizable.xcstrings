  "strings" : {
    "library.all_dhikrs" : {
      "comment" : "Library section title over the list of every dhikr.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جميع الأذكار"
          }
