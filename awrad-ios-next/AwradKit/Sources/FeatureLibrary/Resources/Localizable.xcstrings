        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "എല്ലാ ദിക്റുകളും"
          }
        }
      }
    },
    "library.audio.failed" : {
      "comment" : "Shown when a dhikr's recording can't be played.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تشغيل التسجيل. تحقّق من اتصالك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't play the recording. Check your connection."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "റെക്കോർഡിംഗ് പ്ലേ ചെയ്യാനായില്ല. കണക്ഷൻ പരിശോധിക്കുക."
          }
        }
      }
    },
    "library.audio.pause" : {
      "comment" : "Accessibility label of the button that pauses a dhikr's recording.",
