{
  "name": "awrad-web-next",
  "private": true,
  "description": "Awrad web app: React client of awrad-server-next's API (online-only).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "api:types": "openapi-typescript ../contracts/api/openapi.bundled.json -o src/shared/api/schema.gen.ts",
    "check:api-types": "node scripts/check-api-types.mjs",
    "tokens:colors": "node scripts/generate-colors.mjs",
    "check:colors": "node scripts/generate-colors.mjs --check",
    "check:raw-colors": "node scripts/check-raw-colors.mjs",
    "check:translations": "node scripts/check-translations.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "validate": "npm run check:api-types && npm run check:colors && npm run check:raw-colors && npm run check:translations && npm run typecheck && npm run lint && npm run format:check && npm run depcruise && npm run test && vite build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-router": "1.170.45",
    "i18next": "26.5.2",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "6.0.3"
    }
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "9.39.5",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.47",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "dependency-cruiser": "18.6.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
